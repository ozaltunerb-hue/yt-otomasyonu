# YouTube Otomasyonu V3 — Ortam Değişkenleri (örnek)
# Gerçek değerleri .env dosyasına yaz; .env repo'ya GİRMEZ.

# ── AI ──
OPENAI_API_KEY=sk-...            # Senaryo üretimi (GPT)
KIE_API_KEY=...                  # Seedance 2.0 video üretimi (Kie AI)

# ── Video Birleştirme ──
REPLICATE_API_TOKEN=...          # Çoklu klip merge (Replicate)

# ── YouTube OAuth2 ──
YOUTUBE_CLIENT_ID=...            # Google Cloud OAuth client ID
YOUTUBE_CLIENT_SECRET=...        # Google Cloud OAuth client secret
YOUTUBE_REFRESH_TOKEN=...        # Uzun ömürlü refresh token
YOUTUBE_ENABLED=true             # false → upload atlanır (dry test)
YOUTUBE_CATEGORY_ID=15           # 15 = Pets & Animals (opsiyonel)
YOUTUBE_PRIVACY=public           # public | unlisted | private (opsiyonel)

# ── Notion ──
NOTION_SOCIAL_TOKEN=...          # Sosyal medya workspace token'ı
NOTION_DB_YOUTUBE_OTOMASYON=...  # Video log + tekrar önleme DB ID'si

# ── Sistem ──
# ⚠️ Öğrenci varsayılanı: Geliştirme modunda başlar. Canlıya alırken production yap.
ENV=development                   # production | development
